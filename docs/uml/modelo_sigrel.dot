digraph UML {
graph [rankdir=TB,bgcolor=white,nodesep=0.35,ranksep=0.9, splines=polyline, pad=0.3];
node [shape=plain];
edge [color="#5b7180",penwidth=1.6,arrowsize=0.65,fontname="Arial",fontsize=13];
{rank=same; Cliente; Equipo; Orden;}
{rank=same; Diagnostico; Evento; Asignacion; Tecnico;}
Cliente [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#147d89" BGCOLOR="#f8fdfe" CELLPADDING="1"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#daf5f4"><FONT FACE="Arial" POINT-SIZE="19"><B>Cliente</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- idCliente: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- nombre: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- contacto: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ registrarEquipo()</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ listarEquipos()</FONT></TD></TR></TABLE> >];
Equipo [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#147d89" BGCOLOR="#f8fdfe" CELLPADDING="1"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#daf5f4"><FONT FACE="Arial" POINT-SIZE="19"><B>Equipo</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- idEquipo: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- numeroSerie: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- marca: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- modelo: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ validarSerie()</FONT></TD></TR></TABLE> >];
Orden [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#147d89" BGCOLOR="#f8fdfe" CELLPADDING="1"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#daf5f4"><FONT FACE="Arial" POINT-SIZE="19"><B>OrdenReparacion</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- idOrden: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- fechaIngreso: LocalDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- urgencia: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- estado: EstadoOrden</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- puntuacion: long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ calcularPrioridad()</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ cambiarEstado()</FONT></TD></TR></TABLE> >];
Diagnostico [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#147d89" BGCOLOR="#f8fdfe" CELLPADDING="1"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#daf5f4"><FONT FACE="Arial" POINT-SIZE="19"><B>Diagnostico</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- idDiagnostico: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- descripcion: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- costoEstimado: double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ validarCosto()</FONT></TD></TR></TABLE> >];
Tecnico [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#147d89" BGCOLOR="#f8fdfe" CELLPADDING="1"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#daf5f4"><FONT FACE="Arial" POINT-SIZE="19"><B>Tecnico</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- idTecnico: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- especialidades: Set</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- capacidadMax: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ esCompatible()</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ tieneCupo()</FONT></TD></TR></TABLE> >];
Asignacion [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#147d89" BGCOLOR="#f8fdfe" CELLPADDING="1"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#daf5f4"><FONT FACE="Arial" POINT-SIZE="19"><B>Asignacion</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- idAsignacion: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- fechaInicio: LocalDateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- fechaFin: LocalDateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ cerrar()</FONT></TD></TR></TABLE> >];
Evento [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#147d89" BGCOLOR="#f8fdfe" CELLPADDING="1"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#daf5f4"><FONT FACE="Arial" POINT-SIZE="19"><B>EventoSeguimiento</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- idEvento: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- fecha: LocalDateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- estadoNuevo: EstadoOrden</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">- observacion: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="15">+ registrar()</FONT></TD></TR></TABLE> >];
Cliente -> Equipo [dir=both,arrowtail=none,arrowhead=none,label="1  posee  0..*"];
Equipo -> Orden [dir=both,arrowtail=none,arrowhead=none,label="1  origina  0..*"];
Orden -> Diagnostico [dir=both,arrowtail=diamond,arrowhead=none,label="1  contiene  0..1"];
Orden -> Evento [dir=both,arrowtail=diamond,arrowhead=none,label="1  contiene  0..*"];
Orden -> Asignacion [dir=both,arrowtail=diamond,arrowhead=none,label="1  registra  0..*"];
Tecnico -> Asignacion [dir=both,arrowtail=none,arrowhead=none,label="1  recibe  0..*"];
}